# Copy to .env and edit. Every setting is also settable as an environment
# variable with the same ARCHIVER_ prefix.

# --- backend -----------------------------------------------------------------
# The index domain. An HSDS path (/home/<user>/...) or, with ARCHIVER_BACKEND=local,
# a path to a local .h5 file.
ARCHIVER_DOMAIN=/home/admin/clara/archiver.h5

# auto  - h5py when DOMAIN looks like a local file, h5pyd otherwise
# hsds  - always h5pyd
# local - always h5py (useful for a single-machine trial without a server)
ARCHIVER_BACKEND=auto

ARCHIVER_HSDS_ENDPOINT=http://localhost:5101
ARCHIVER_HSDS_USERNAME=admin
ARCHIVER_HSDS_PASSWORD=admin
# ARCHIVER_HSDS_BUCKET=

# --- performance -------------------------------------------------------------
# Seconds before the cached index extent is re-checked against the domain.
ARCHIVER_CACHE_TTL_SECONDS=30
# Ceiling on the in-process PV column cache.
ARCHIVER_PV_CACHE_MIB=256
# Hyperslab reads issued in parallel for one query.
ARCHIVER_READ_WORKERS=8

# --- limits ------------------------------------------------------------------
ARCHIVER_MAX_LIMIT=1000
ARCHIVER_MAX_EXPORT_ROWS=1000000

# --- server ------------------------------------------------------------------
ARCHIVER_API_HOST=127.0.0.1
ARCHIVER_API_PORT=8000
